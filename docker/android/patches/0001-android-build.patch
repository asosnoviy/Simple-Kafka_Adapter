+# The NDK toolchain sets CMAKE_SYSTEM_NAME to "Android".
+set(SIMPLEKAFKA_ANDROID OFF)
+if (CMAKE_SYSTEM_NAME STREQUAL "Android")
+    set(SIMPLEKAFKA_ANDROID ON)
+endif()
+
+# Feature level of the build:
+#   kafka  - Kafka only, without AVRO, Protobuf and Schema Registry. Needs
+#            nothing but librdkafka and Boost.JSON, so it is the fallback for
+#            a platform where the schema dependencies do not build.
+#   schema - plus AVRO, Protobuf and Schema Registry. The Schema Registry is
+#            reached over plain HTTP: the build has no TLS runtime.
+set(SIMPLEKAFKA_FEATURE_LEVEL "schema" CACHE STRING "Feature level: kafka or schema")
+set_property(CACHE SIMPLEKAFKA_FEATURE_LEVEL PROPERTY STRINGS kafka schema)
+
+if (SIMPLEKAFKA_FEATURE_LEVEL STREQUAL "kafka")
+    message(STATUS "Feature level kafka: AVRO, Protobuf, Schema Registry and CURL are disabled")
+else()
+    message(STATUS "Feature level schema: AVRO, Protobuf and Schema Registry are enabled")
+endif()
+
